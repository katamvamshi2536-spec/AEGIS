# =============================================================================
# AEGIS - Environment Configuration
# =============================================================================

# Deployment Environment
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Amazon Ring Developer Integration
# -----------------------------------------------------------------------------
# Leave blank to operate in high-fidelity SIMULATION MODE (5 Ring devices)
# Or provide your official Amazon Ring developer tokens for LIVE Ring Cloud mode
RING_AUTH_TOKEN=
RING_REFRESH_TOKEN=
RING_WEBHOOK_SECRET=aegis-ring-live-webhook-secret-token

# -----------------------------------------------------------------------------
# AWS Builder Services (Amazon Bedrock, AgentCore, DynamoDB, S3, CloudWatch)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS Credentials (Optional in local developer mode; falls back to Strands local runtime)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Resource Identifiers
DYNAMODB_TABLE=aegis_security_state_production
EVIDENCE_BUCKET=aegis-security-evidence-production

# -----------------------------------------------------------------------------
# PolicyMesh & Agent Configuration
# -----------------------------------------------------------------------------
POLICY_ZERO_TRUST_MODE=true
RISK_THRESHOLD_CRITICAL=81
RISK_THRESHOLD_HIGH=61
RISK_THRESHOLD_MEDIUM=31
